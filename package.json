{
	"name": "flickgrab",
	"version": "0.1.0",
	"private": true,
	"description": "FlickGrab — media-free link control plane with on-device downloads",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "node scripts/run.mjs dev",
		"dev:web": "next dev",
		"dev:api": "tsx watch server/index.ts",
		"build": "next build",
		"start": "node scripts/run.mjs start",
		"start:web": "next start",
		"start:api": "tsx server/index.ts",
		"lint": "eslint .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"cors": "2.8.6",
		"express": "5.3.0",
		"express-rate-limit": "8.7.4",
		"helmet": "8.3.0",
		"next": "16.2.6",
		"react": "19.2.6",
		"react-dom": "19.2.6",
		"tsx": "4.23.15",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "4.1.17",
		"@types/cors": "2.8.19",
		"@types/express": "5.0.6",
		"@types/node": "22.19.15",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"@types/supertest": "7.2.1",
		"eslint": "9.39.4",
		"eslint-config-next": "16.2.6",
		"postcss": "8.5.8",
		"supertest": "7.3.2",
		"tailwindcss": "4.1.17",
		"typescript": "5.9.3",
		"vitest": "5.1.0"
	},
	"engines": {
		"node": ">=22.13"
	}
}
